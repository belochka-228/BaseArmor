<Page x:Class="BaseArmor.CRUD.BookingTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.CRUD"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookingTabPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <TextBlock Text="Таблица броней" HorizontalAlignment="Center" Style="{StaticResource HeaderText}"/>
        </Border>

        <DataGrid Grid.Row="1" x:Name="DataGridBooking" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.last_name}" Width="120"/>
                <DataGridTextColumn Header="Ресторан" Binding="{Binding DiningTable.Halls.Restaurants.name}" Width="150"/>
                <DataGridTextColumn Header="Зал" Binding="{Binding DiningTable.Halls.name}" Width="120"/>
                <DataGridTextColumn Header="Столик" Binding="{Binding DiningTable.id}" Width="70"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding start_datatime, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                <DataGridTextColumn Header="Гостей" Binding="{Binding guests_count}" Width="70"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status.name}" Width="100"/>
                <DataGridTemplateColumn Header="Действия" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="BtnEdit_Click" FontSize="11" Padding="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Добавить" Click="BtnAdd_Click" Width="150"/>
            <Button Content="Удалить" Click="BtnDelete_Click" Width="150"/>
            <Button Content="Назад" Click="BtnBack_Click" Width="150" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Page>