<Page x:Class="BaseArmor.CRUD.AddBookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.CRUD"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddBookingPage">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource CardBorder}" Width="500">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="650">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Добавление брони" Style="{StaticResource HeaderText}"/>

                    <TextBlock Text="Пользователь"/>
                    <ComboBox x:Name="cmbUser" DisplayMemberPath="login" SelectedValuePath="id" SelectedValue="{Binding user_id}"/>

                    <TextBlock Text="Столик"/>
                    <ComboBox x:Name="cmbTable" DisplayMemberPath="id" SelectedValuePath="id" SelectedValue="{Binding table_id}"/>

                    <TextBlock Text="Дата и время (например, 25.12.2026 18:00)"/>
                        <TextBox x:Name="txtDate"/>

                        <TextBlock Text="Длительность (мин.)"/>
                    <TextBox x:Name="txtDuration" Text="{Binding duration_minutes}"/>

                    <TextBlock Text="Количество гостей"/>
                    <TextBox x:Name="txtGuests" Text="{Binding guests_count}"/>

                    <TextBlock Text="Статус"/>
                    <ComboBox x:Name="cmbStatus" DisplayMemberPath="name" SelectedValuePath="id" SelectedValue="{Binding status_id}"/>

                    <TextBlock Text="Комментарий"/>
                    <TextBox x:Name="txtComment" Text="{Binding comment}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <Button Content="Сохранить" Click="BtnSave_Click" Margin="0,20,0,0"/>
                    <Button Content="Назад" Click="BtnBack_Click" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
