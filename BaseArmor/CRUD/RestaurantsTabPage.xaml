<Page x:Class="BaseArmor.CRUD.RestaurantsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.CRUD"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RestaurantsTabPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <TextBlock Text="Таблица ресторанов" HorizontalAlignment="Center" Style="{StaticResource HeaderText}"/>
        </Border>

        <DataGrid Grid.Row="1" x:Name="DataGridRestaurants" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="150"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding address}" Width="200"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding rating}" Width="80"/>
                <DataGridTextColumn Header="Средний чек" Binding="{Binding average_check}" Width="100"/>
                <DataGridTemplateColumn Header="Действия" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="BtnEdit_Click" FontSize="11" Padding="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Добавить" Click="BtnAdd_Click" Width="150"/>
            <Button Content="Удалить" Click="BtnDelete_Click" Width="150"/>
            <Button Content="Назад" Click="BtnBack_Click" Width="150" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Page>