<Page x:Class="BaseArmor.Pages._4HallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_4HallPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Width="400">
            <TextBlock x:Name="TitleRestik" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource HeaderText}"/>
        </Border>
        <StackPanel Orientation="Horizontal" Grid.Row="1" >
            <TextBlock Text="Поиск: " Style="{StaticResource DarkText}"/>
            <TextBox x:Name="txtSource" Width="200" TextChanged="txtSource_TextChanged"/>

            <TextBlock Text="Депозит: " Margin="10" VerticalAlignment="Center" Style="{StaticResource DarkText}"/>
            <RadioButton x:Name="rbAll" Content="Все" IsChecked="True" GroupName="Deposit" Margin="5,0,0,0" Checked="rb_Checked" VerticalAlignment="Center"/>
            <RadioButton x:Name="rbWithDeposit" Content="С депозитом" GroupName="Deposit" Margin="5,0,0,0" Checked="rb_Checked" VerticalAlignment="Center"/>
            <RadioButton x:Name="rbWithoutDeposit" Content="Без депозита" GroupName="Deposit" Margin="5,0,0,0" Checked="rb_Checked" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListHalls">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Width="250">
                            <StackPanel Orientation="Vertical">
                                <Image Source="{Binding photo_url}" Stretch="UniformToFill" Height="200"/>
                                <TextBlock Text="{Binding name}" Style="{StaticResource HeaderText}"/>
                                <TextBlock Text="{Binding has_deposit, StringFormat= Депозит: {0}}"/>
                                <TextBlock Text="{Binding capacity, StringFormat= Вместимось зала: {0}}"/>
                                <TextBlock Text="{Binding description}"/>

                                <Button Content="Выбрать" Click="Button_Click" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button Content="Назад к ресторанам" Click="BtnRestiki_Click"/>
            <Button Content="Выйти из системы" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
