<Page x:Class="BaseArmor.Pages._2RegistrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.Pages"
      mc:Ignorable="d" 
      Title="_2RegistrPage">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource CardBorder}" Width="370" Height="550">
            <StackPanel Width="300">
                <TextBlock Text="Регистрация" Style="{StaticResource HeaderText}"/>

                <TextBlock Text="Ваша фамилия"/>
                <TextBox x:Name="txtLastName"/>

                <TextBlock Text="Ваше имя"/>
                <TextBox x:Name="txtFirstName"/>

                <TextBlock Text="Номер телефона"/>
                <TextBox x:Name="txtNumber"/>
                
                <TextBlock Text="Почта"/>
                <TextBox x:Name="txtEmail"/>

                <TextBlock Text="Логин"/>
                <TextBox x:Name="txtLogin"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="txtPassword"/>

                <TextBlock Text="Повторите пароль"/>
                <PasswordBox x:Name="txtPasswordConfirm"/>

                <Button Content="Зарегистрироваться" Click="Register_Click"/>
                <Button Content="Назад" Click="Back_Click" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
