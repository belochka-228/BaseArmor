<Page x:Class="BaseArmor.Pages._9DepozitPay"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_9DepozitPay">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <TextBlock Text="Оплата депозита" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource HeaderText}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>

                <TextBlock Text="Сумма к оплате:"/>
                <TextBlock x:Name="txtOplata" Style="{StaticResource HeaderText}" FontSize="28" Foreground="{StaticResource PrimaryBrush}"/>

                <TextBlock Text="Выберите способ оплаты:" Margin="0,10,0,7"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbCard" Content="Банковская карта" GroupName="MethodPay" IsChecked="True" Margin="5,0,0,0" Checked="PaymentMethod_Checked"/>
                    <RadioButton x:Name="rbSBP" Content="СБП (QR-код)" GroupName="MethodPay" Margin="5,0,0,0" Checked="PaymentMethod_Checked"/>
                </StackPanel>

                <StackPanel x:Name="PanelCard" Margin="0,15,0,0">
                    <TextBlock Text="Номер карты:"/>
                    <Grid>
                        <TextBox x:Name="txtCardNumber" MaxLength="19" TextChanged="txtCardNumber_TextChanged"/>
                        <TextBlock x:Name="txtCardNumberHint" Text="0000 0000 0000 0000" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtCardNumberHint_MouseLeftButtonUp"/>
                    </Grid>

                    <TextBlock Text="Срок действия:"/>
                    <Grid>
                        <TextBox x:Name="txtCardDate" MaxLength="5" TextChanged="txtCardDate_TextChanged"/>
                        <TextBlock x:Name="txtCardDateHint" Text="ММ/ГГ" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtCardDateHint_MouseLeftButtonUp"/>
                    </Grid>

                    <TextBlock Text="CVV:"/>
                    <Grid>
                        <TextBox x:Name="txtCVV" MaxLength="3" TextChanged="txtCVV_TextChanged"/>
                        <TextBlock x:Name="txtCVVHint" Text="***" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtCVVHint_MouseLeftButtonUp"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PanelQR" Margin="0,15,0,0" Visibility="Collapsed">
                    <TextBlock Text="Отсканируйте QR-код для оплаты" HorizontalAlignment="Center"/>
                    <Image Source="/Images/qrcode_github.com.png" Stretch="Uniform" Height="200" HorizontalAlignment="Center"/>
                </StackPanel>

                <Button Content="Оплатить" Click="Pay_Click"/>
                <Button Content="Отменить бронь" Click="Cancel_Click" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
