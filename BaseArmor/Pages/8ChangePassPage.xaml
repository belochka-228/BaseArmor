<Page x:Class="BaseArmor.Pages._8ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_8ChangePassPage">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource CardBorder}" Width="380">
            <StackPanel Width="300">
                <TextBlock Text="Смена пароля" Style="{StaticResource HeaderText}"/>

                <!-- ЛОГИН -->
                <TextBlock Text="Логин"/>
                <Grid>
                    <TextBox x:Name="txtLogin" TextChanged="txtLogin_TextChanged"/>
                    <TextBlock x:Name="txtLoginHint" Text="Введите логин" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtLoginHint_MouseLeftButtonUp"/>
                </Grid>

                <!-- СТАРЫЙ ПАРОЛЬ -->
                <TextBlock Text="Текущий пароль"/>
                <Grid>
                    <PasswordBox x:Name="txtOldPassword" PasswordChanged="txtOldPassword_PasswordChanged"/>
                    <TextBlock x:Name="txtOldPasswordHint" Text="Введите текущий пароль" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtOldPasswordHint_MouseLeftButtonUp"/>
                </Grid>

                <!-- НОВЫЙ ПАРОЛЬ -->
                <TextBlock Text="Новый пароль"/>
                <Grid>
                    <PasswordBox x:Name="txtNewPassword" PasswordChanged="txtNewPassword_PasswordChanged"/>
                    <TextBlock x:Name="txtNewPasswordHint" Text="Введите новый пароль" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtNewPasswordHint_MouseLeftButtonUp"/>
                </Grid>

                <!-- ПОДТВЕРЖДЕНИЕ -->
                <TextBlock Text="Повторите новый пароль"/>
                <Grid>
                    <PasswordBox x:Name="txtConfirmPassword" PasswordChanged="txtConfirmPassword_PasswordChanged"/>
                    <TextBlock x:Name="txtConfirmPasswordHint" Text="Повторите новый пароль" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtConfirmPasswordHint_MouseLeftButtonUp"/>
                </Grid>

                <!-- КНОПКИ -->
                <Button Content="Сохранить" Click="Save_Click"/>
                <Button Content="Назад" Click="Back_Click" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
