<Page x:Class="BaseArmor.Pages._1LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1LoginPage">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource CardBorder}" Width="380">
            <StackPanel Width="300">
                <TextBlock Text="Бронирование столиков" Style="{StaticResource HeaderText}" />
                <TextBlock Text="«Секунда»" Style="{StaticResource HeaderText}"/>

                <TextBlock Text="Логин"/>
                <Grid>
                    <TextBox x:Name="txtUser" TextChanged="txtUser_TextChanged"/>
                    <TextBlock x:Name="txtUserHint" Text="Введите логин" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtUserHint_MouseLeftButtonUp"/>
                </Grid>

                <TextBlock Text="Пароль"/>
                <Grid>
                    <PasswordBox x:Name="txtPassword" PasswordChanged="txtPassword_PasswordChanged"/>
                    <TextBlock x:Name="txtPasswordHint" Text="Введите пароль" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtPasswordHint_MouseLeftButtonUp"/>
                </Grid>

                <Button Content="Войти" Click="AutoButton_Click" />
                <Button Content="Регистрация" Click="RegisterButton_Click" 
                        Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
