<Page x:Class="BaseArmor.Pages._1LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1LoginPage">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource CardBorder}" Width="380">
            <StackPanel Width="300">
                <TextBlock Text="Бронирование столиков" Style="{StaticResource HeaderText}" />
                <TextBlock Text="«Котики вперед»" Style="{StaticResource HeaderText}"/>

                <TextBlock Text="Логин"/>
                <Grid>
                    <TextBox x:Name="txtUser" TextChanged="txtUser_TextChanged"/>
                    <TextBlock x:Name="txtUserHint" Text="Введите логин" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtUserHint_MouseLeftButtonUp"/>
                </Grid>

                <TextBlock Text="Пароль"/>
                <Grid>
                    <PasswordBox x:Name="txtPassword" PasswordChanged="txtPassword_PasswordChanged"/>
                    <TextBlock x:Name="txtPasswordHint" Text="Введите пароль" Style="{StaticResource PlaceholderText}" MouseLeftButtonUp="txtPasswordHint_MouseLeftButtonUp"/>
                </Grid>

                <Button x:Name="ButtonAuth" Content="Войти" Click="AutoButton_Click" />
                <Button Content="Регистрация" Click="RegisterButton_Click"  Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"/>
                <Button x:Name="ButtonChangePassword" Content="Смена пароля" Click="ButtonChangePassword_Click" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"/>

                <TextBlock x:Name="txtCaptcha" Text="Капча:" Visibility="Hidden"/>
                <TextBox x:Name="captcha" CommandManager.PreviewExecuted="textBox_PreviewExecuted" ContextMenu="{x:Null}" 
                         Visibility="Hidden" Height="42" Foreground="Red" FontStyle="Oblique" FontWeight="Bold" TextDecorations="Strikethrough"
                         Background="{x:Null}" FontStretch="UltraCondensed" IsReadOnly="True" HorizontalContentAlignment="Center" 
                         VerticalContentAlignment="Center" FontSize="20" Margin="0,5,0,5"/>
                <TextBox x:Name="captchaInput" Visibility="Hidden" Height="34" TextWrapping="Wrap" Text=""/>
                <Button x:Name="submitCaptcha" Content="Подтвердить" ToolTip="Подтвердить ввод капчи" Visibility="Hidden" 
                        Click="submitCaptcha_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
