<Page x:Class="BaseArmor.Pages._7AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_7AdminPage">

    <Grid Margin="15">
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Таблица пользователей" Width="300" Height="50" Margin="10" Click="BtnUsers_Click"/>
            <Button Content="Таблица ресторанов" Width="300" Height="50" Margin="10" Click="BtnRestaurants_Click"/>
            <Button Content="Таблица броней" Width="300" Height="50" Margin="10" Click="BtnBooking_Click"/>
            <Button Content="Диаграммы" Width="300" Height="50" Margin="10" Click="BtnDiagram_Click"/>
        </StackPanel>
    </Grid>
</Page>
