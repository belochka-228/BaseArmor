<Page x:Class="BaseArmor.Pages._6UseProfPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_6UseProfPage">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Width="400">
            <TextBlock Text="Личный кабинет" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource HeaderText}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,5,0,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="30,0">
                    <TextBlock Text="ФИО:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtFIO"/>
                </StackPanel>
                <StackPanel Margin="30,0">
                    <TextBlock Text="Телефон:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtPhone"/>
                </StackPanel>
                <StackPanel Margin="30,0">
                    <TextBlock Text="Логин:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtLogin"/>
                </StackPanel>
                <StackPanel Margin="30,0">
                    <TextBlock Text="Роль:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtRole"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Мои брони" Style="{StaticResource HeaderText}" FontSize="25"/>
                <ScrollViewer>
                    <ItemsControl x:Name="LstMyBroni" Cursor="">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="5" BorderThickness="1">
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DiningTable.Halls.Restaurants.name, StringFormat=Ресторан: {0}}"/>
                                            <TextBlock Text="{Binding DiningTable.Halls.name, StringFormat=Зал: {0}}"/>
                                            <TextBlock Text="{Binding DiningTable.id, StringFormat=Столик: {0}}"/>
                                            <TextBlock Text="{Binding start_datetime, StringFormat=Дата брони: {0}}"/>
                                            <TextBlock Text="{Binding quest_count, StringFormat=Количество гостей: {0}}"/>
                                            <TextBlock Text="{Binding Status.name, StringFormat=Статус: {0}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                                            <Button Content="Отменить" Click="BtnOtmenaBroni_Click" Height="20"/>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <TextBlock Text="Мои ожидания" Style="{StaticResource HeaderText}" FontSize="25"/>
                <ScrollViewer>
                    <ItemsControl x:Name="LstMyExpectations">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="5" BorderThickness="1" HorizontalAlignment="Stretch">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="400"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Restaurants.name, StringFormat=Ресторан: {0}}"/>
                                            <TextBlock Text="{Binding Halls.name, StringFormat=Зал: {0}}"/>
                                            <TextBlock Text="{Binding desired_datetime, StringFormat=Желаемая дата: {0}}"/>
                                            <TextBlock Text="{Binding quest_count, StringFormat=Количество гостей: {0}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                                            <TextBlock x:Name="lblStatus" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Еще нет свободных столиков("/>
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanBook}" Value="True">
                                                                <Setter Property="Text" Value="Свободный столик появился!))"/>
                                                                <Setter Property="Foreground" Value="Green"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="btnBook" Width="200" Content="Забронировать" Click="BookFromWaitlist_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanBook}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="🗑️" Click="RemoveWaitlist_Click" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Новая бронь" Click="BtnRest_Click"/>
            <Button Content="Выйти из системы" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
