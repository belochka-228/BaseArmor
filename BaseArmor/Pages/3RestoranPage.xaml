<Page x:Class="BaseArmor.Pages._3RestoranPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BaseArmor.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_3RestoranPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Width="400">
            <TextBlock Text="Выбор ресторана" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource HeaderText}"/>
        </Border>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2">
            <TextBlock Text="Поиск: " Style="{StaticResource DarkText}"/>
            <TextBox x:Name="txtSource" Width="200" TextChanged="txtSource_TextChanged"/>

            <TextBlock Text="Сортировка по: " Margin="10" VerticalAlignment="Center" Style="{StaticResource DarkText}"/>
            <ComboBox x:Name="cmbSort" Width="200" SelectionChanged="cmbSort_SelectionChanged" VerticalAlignment="Center" Height="30">
                <ComboBoxItem>По рейтингу</ComboBoxItem>
                <ComboBoxItem>По среднему чеку (возр)</ComboBoxItem>
                <ComboBoxItem>По среднему чеку (умен)</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListRestorans">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Width="400">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding name}" Style="{StaticResource HeaderText}"/>
                                <Image Source="{Binding photo_url}" Stretch="UniformToFill" Height="200"/>
                                <TextBlock Text=""/>
                                <TextBlock Text="{Binding address}"/>
                                <TextBlock Text="{Binding rating, StringFormat= Рейтинг: {0}}"/>
                                <TextBlock Text="{Binding average_check, StringFormat= Средний чек: {0}}"/>
                                <TextBlock Text="{Binding description}" TextWrapping="Wrap"/>

                                <Button Content="Выбрать" Click="Button_Click" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Left"  VerticalAlignment="Bottom">
            <Button  Click="BtnProfil_Click" Width="60" Height="60">
                <Image Source="/Images/profil.jpg" Stretch="Uniform" />
            </Button>
            <Button Click="BtnBack_Click" Width="60" Height="60">
                <Image Source="/Images/exit.png" Stretch="Uniform"/>
            </Button>
        </StackPanel>
    </Grid>
</Page>
